const web3 = require("web3")
const RLP = require('rlp');

// Configure
const validators = [
  {% for v in validators %}
   {
     "consensusAddr": "{{ v.consensusAddr }}",
     "feeAddr": "{{ v.feeAddr }}",
   },{% endfor %}
];

const bLSPublicKeys = [];

// ===============  Do not edit below ====
function generateExtradata(validators) {
  let extraVanity =Buffer.alloc(32);
  let validatorsBytes = extraDataSerialize(validators);
  let extraSeal =Buffer.alloc(65);
  return Buffer.concat([extraVanity,validatorsBytes,extraSeal]);
}

function extraDataSerialize(validators) {
  let n = validators.length;
  let arr = [];
  // Validator count (1 byte) + validators (address + BLS key for each)
  arr.push(Buffer.from([n])); // validator count as 1 byte

  for (let i = 0; i < n; i++) {
    // Add consensus address (20 bytes)
    arr.push(Buffer.from(web3.utils.hexToBytes(validators[i].consensusAddr)));
    // Add BLS key
    if (typeof bLSPublicKeys[i] !== 'undefined') {
      arr.push(Buffer.from(web3.utils.hexToBytes(bLSPublicKeys[i])));
    }
  }
  return Buffer.concat(arr);
}

function validatorUpdateRlpEncode(validators) {
  let n = validators.length;
  let vals = [];
  for (let i = 0;i<n;i++) {
    vals.push([
      validators[i].consensusAddr,
      validators[i].feeAddr,
    ]);
    if (typeof bLSPublicKeys[i] !== 'undefined') {
      vals[i].push(bLSPublicKeys[i]);
    }
  }
  return web3.utils.bytesToHex(RLP.encode(vals));
}

extraValidatorBytes = generateExtradata(validators,bLSPublicKeys);
validatorSetBytes = validatorUpdateRlpEncode(validators,bLSPublicKeys);

exports = module.exports = {
  extraValidatorBytes: extraValidatorBytes,
  validatorSetBytes: validatorSetBytes,
}